# syntax=docker/dockerfile:1
# The one Pebbles image (REQ-01/02). Docker and Podman build this file directly;
# Incus consumes the CI-converted artifact of the same image (image/lxc/).
# Role is chosen at first boot via PEBBLES_ROLE and sticky in the config volume.

########## Rust: static pebblesd + kernels (NFR-02) ##########
FROM rust:alpine AS rust-builder
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY kernels ./kernels
RUN cargo build --release -p pebblesd -p sql-runner

########## Frontend: React workbench → static bundle (air-gapped, NFR-03) ##########
FROM node:22-bookworm-slim AS frontend-builder
WORKDIR /build/frontend
COPY web/frontend/package.json web/frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/frontend/ ./
RUN npm run build
# vite outDir is ../pebbles_web/static/app → /build/pebbles_web/static/app

########## Python: web venv (isolated from Airflow and the user stack) ##########
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS web-builder
WORKDIR /opt/pebbles/web
COPY web/ .
ENV UV_PYTHON_DOWNLOADS=never
RUN uv sync --no-dev

########## Airflow: its OWN venv (REQ-38; nothing outside it imports from it) ##########
# Airflow 2.10 (not 3.x): its LocalExecutor runs tasks as direct subprocesses
# against the metadata DB — no Task Execution API / JWT handshake to configure.
# Airflow is a hidden, swappable internal dependency (spec §risks), and 2.10 is
# the simplest reliable single-node headless executor.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS airflow-builder
WORKDIR /opt/pebbles/airflow
ARG AIRFLOW_VERSION=2.10.4
ENV UV_PYTHON_DOWNLOADS=never
RUN uv venv .venv \
    && uv pip install --python .venv/bin/python \
       "apache-airflow[postgres]==${AIRFLOW_VERSION}" \
       --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-${AIRFLOW_VERSION}/constraints-3.12.txt"

########## Runtime ##########
FROM python:3.12-slim-bookworm
ARG TARGETARCH
ARG DUCKDB_VERSION=1.5.2
# git: REQ-32..37 · openssh-server: SFTP parity (REQ-15) · postgresql: DuckLake catalog
# The `pebbles` group gates the pebblesd socket; `pebbles-web` runs gunicorn (never root).
RUN apt-get update \
    && apt-get install -y --no-install-recommends git openssh-server ca-certificates curl postgresql busybox \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system pebbles \
    && useradd --system --gid pebbles --home-dir /nonexistent --shell /usr/sbin/nologin pebbles-web \
    && useradd --system --gid pebbles --home-dir /var/lib/pebbles/airflow --shell /usr/sbin/nologin pebbles-airflow

# Python, R and Jupyter via miniforge (conda-forge) with the bundled scientific
# stack (PRD REQ-51/52). One early layer, ordered BEFORE any source COPY so it
# caches across code changes. Users extend it themselves: `pip install --user`
# and personal conda envs in their homes need no admin.
# A dedicated `pebbles` env (never base — base pins its own python): python is
# pinned to 3.12 because pmdarima has no 3.13 builds yet.
RUN curl -fsSL -o /tmp/miniforge.sh \
       "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-$(uname -m).sh" \
    && bash /tmp/miniforge.sh -b -p /opt/conda \
    && rm /tmp/miniforge.sh \
    && arch_extras="$([ "$(uname -m)" = "x86_64" ] && echo r-duckdb || true)" \
    && /opt/conda/bin/mamba create -y -n pebbles python=3.12 \
       jupyterlab ipykernel \
       numpy pandas scipy statsmodels scikit-learn matplotlib seaborn plotnine \
       geopandas duckdb polars networkx pmdarima xgboost openpyxl \
       r-essentials r-gtsummary r-arrow r-tidymodels r-survey ${arch_extras} \
    && /opt/conda/bin/conda clean -afy \
    && find /opt/conda -name '*.a' -delete \
    && rm -rf /opt/conda/envs/pebbles/share/doc /opt/conda/envs/pebbles/share/man \
    && chmod -R a+rX /opt/conda
ENV PATH="/opt/conda/envs/pebbles/bin:/opt/conda/bin:${PATH}"

# DuckDB CLI + DuckLake/postgres extensions, vendored at BUILD time for this exact
# version and platform. Runtime never fetches anything (NFR-03): sessions LOAD from
# this shared, read-only extension directory.
RUN curl -fsSL -o /tmp/duckdb.zip \
       "https://github.com/duckdb/duckdb/releases/download/v${DUCKDB_VERSION}/duckdb_cli-linux-${TARGETARCH}.zip" \
    && python3 -m zipfile -e /tmp/duckdb.zip /usr/local/bin/ \
    && chmod 755 /usr/local/bin/duckdb \
    && rm /tmp/duckdb.zip \
    && mkdir -p /opt/pebbles/duckdb/extensions \
    && HOME=/tmp duckdb -c "SET extension_directory='/opt/pebbles/duckdb/extensions'; INSTALL ducklake; INSTALL postgres;" \
    && chmod -R a+rX /opt/pebbles/duckdb

COPY --from=rust-builder /src/target/release/pebblesd /usr/local/bin/pebblesd
COPY --from=rust-builder /src/target/release/sql-runner /usr/local/bin/pebbles-sql-runner
COPY --from=web-builder /opt/pebbles/web /opt/pebbles/web
COPY --from=frontend-builder /build/pebbles_web/static/app /opt/pebbles/web/pebbles_web/static/app
COPY --from=airflow-builder /opt/pebbles/airflow /opt/pebbles/airflow
COPY image/rootfs/ /
RUN chmod 755 /opt/pebbles/scripts/udhcpc.sh

# pebblesd is the init for every runtime: OCI entrypoint here, /sbin/init for Incus
# system containers. One init contract (implementation plan §2.1).
RUN ln -sf /usr/local/bin/pebblesd /sbin/init

ENV PEBBLES_CONFIG=/var/lib/pebbles
VOLUME /var/lib/pebbles
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/pebblesd"]
