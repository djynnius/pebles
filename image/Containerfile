# syntax=docker/dockerfile:1
# The one Pebbles image (REQ-01/02). Docker and Podman build this file directly;
# Incus consumes the CI-converted artifact of the same image (image/lxc/).
# Role is chosen at first boot via PEBBLES_ROLE and sticky in the config volume.

########## Rust: static pebblesd + kernels (NFR-02) ##########
FROM rust:alpine AS rust-builder
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY kernels ./kernels
RUN cargo build --release -p pebblesd -p sql-runner

########## Python: web venv (isolated; Airflow gets its OWN venv in Phase 1) ##########
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS web-builder
WORKDIR /opt/pebbles/web
COPY web/ .
ENV UV_PYTHON_DOWNLOADS=never
RUN uv sync --no-dev

########## Runtime ##########
FROM python:3.12-slim-bookworm
ARG TARGETARCH
ARG DUCKDB_VERSION=1.5.2
# git: REQ-32..37 · openssh-server: SFTP parity (REQ-15) · postgresql: DuckLake catalog
# The `pebbles` group gates the pebblesd socket; `pebbles-web` runs gunicorn (never root).
RUN apt-get update \
    && apt-get install -y --no-install-recommends git openssh-server ca-certificates curl postgresql \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system pebbles \
    && useradd --system --gid pebbles --home-dir /nonexistent --shell /usr/sbin/nologin pebbles-web

# DuckDB CLI + DuckLake/postgres extensions, vendored at BUILD time for this exact
# version and platform. Runtime never fetches anything (NFR-03): sessions LOAD from
# this shared, read-only extension directory.
RUN curl -fsSL -o /tmp/duckdb.zip \
       "https://github.com/duckdb/duckdb/releases/download/v${DUCKDB_VERSION}/duckdb_cli-linux-${TARGETARCH}.zip" \
    && python3 -m zipfile -e /tmp/duckdb.zip /usr/local/bin/ \
    && chmod 755 /usr/local/bin/duckdb \
    && rm /tmp/duckdb.zip \
    && mkdir -p /opt/pebbles/duckdb/extensions \
    && HOME=/tmp duckdb -c "SET extension_directory='/opt/pebbles/duckdb/extensions'; INSTALL ducklake; INSTALL postgres;" \
    && chmod -R a+rX /opt/pebbles/duckdb

COPY --from=rust-builder /src/target/release/pebblesd /usr/local/bin/pebblesd
COPY --from=rust-builder /src/target/release/sql-runner /usr/local/bin/pebbles-sql-runner
COPY --from=web-builder /opt/pebbles/web /opt/pebbles/web

# pebblesd is the init for every runtime: OCI entrypoint here, /sbin/init for Incus
# system containers. One init contract (implementation plan §2.1).
RUN ln -sf /usr/local/bin/pebblesd /sbin/init

ENV PEBBLES_CONFIG=/var/lib/pebbles
VOLUME /var/lib/pebbles
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/pebblesd"]
